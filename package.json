{
  "name": "@gorth-io/launcher",
  "productName": "Gorth Launcher",
  "version": "0.0.0-alpha.3",
  "description": "Minecraft instance manager",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "private": true,
  "overrides": {
    "@better-auth/core": "1.7.21",
    "@opentelemetry/api": "1.10.0"
  },
  "scripts": {
    "prettier": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:window": "vitest run tests/vitest/window.test.ts",
    "test:unit": "vitest run tests/vitest/development-lifecycle.test.ts tests/vitest/forge-lifecycle.test.ts",
    "test:formatter": "deno run scripts/test-formatter.mjs",
    "test:desktop-packages": "deno run scripts/test-desktop-packages.mjs",
    "test:rpc": "vitest run tests/rpc.test.ts",
    "test:dashboard": "vitest run --configLoader runner --no-cache --no-fsModuleCache tests/vitest/shared-ui-native.test.ts",
    "test:pages:ui": "deno run scripts/test-launcher-pages.mjs",
    "test:auth:ui": "deno run scripts/test-auth-screen-native.mjs",
    "test:server": "deno run scripts/test-desktop-server.mjs",
    "test:server:native": "deno run scripts/test-desktop-server-native.mjs",
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build:mac:intel": "electron-forge make --platform=darwin --arch=x64 --targets=@electron-forge/maker-dmg",
    "build:mac:arm": "electron-forge make --platform=darwin --arch=arm64 --targets=@electron-forge/maker-dmg",
    "build:windows:exe": "electron-forge make --platform=win32 --arch=x64 --targets=squirrel",
    "build:windows:msi": "electron-forge make --platform=win32 --arch=x64 --targets=squirrel",
    "build:linux:deb": "electron-forge make --platform=linux --arch=x64 --targets=deb",
    "build:linux:rpm": "electron-forge make --platform=linux --arch=x64 --targets=rpm",
    "publish": "electron-forge publish",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "pull": "ncu -u -x typescript,deno --dep prod,dev,optional,peer,packageManager && deno i",
    "test:auth": "vitest run tests/auth.test.ts tests/auth-service.test.ts tests/auth-view.test.ts",
    "test:auth:embedded": "vitest run tests/vitest/auth-embedded.test.ts",
    "test:game": "deno run scripts/test-game.mjs",
    "test:library": "deno run scripts/test-library.mjs",
    "test:content": "deno run scripts/test-content.mjs",
    "test:instance-data": "deno run scripts/test-instance-data.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [],
  "author": {
    "name": "goraria",
    "email": "gorariagroup@gmail.com"
  },
  "license": "MIT",
  "packageManager": "deno@2.9.8",
  "engines": {
    "node": "26.x"
  },
  "deno": {
    "onlyBuiltDependencies": [
      "@gorth-io/primitive",
      "@gorth-io/principle",
      "@gorth-io/structure",
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "macos-alias",
      "fs-xattr",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": []
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/electron": "1.7.21",
    "@fontsource-variable/inter": "^5.3.0",
    "@gorth-io/primitive": "0.0.0-alpha.10",
    "@gorth-io/principle": "0.0.0-alpha.10",
    "@gorth-io/structure": "0.0.0-alpha.10",
    "@trpc/client": "^11.28.0",
    "@trpc/server": "^11.28.0",
    "@trpc/tanstack-react-query": "^11.28.0",
    "better-auth": "1.7.21",
    "better-sqlite3": "^13.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "electron-squirrel-startup": "^1.0.1",
    "extract-zip": "2.0.1",
    "nitro": "3.0.261103-rc",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "45.3.1",
    "esbuild": "0.28.2",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
