# Packaged renderer origin. In dev Forge supplies the renderer's actual origin.
# pnpm dev/start: Forge loads all .env.local keys into main before Electron starts.
# Shell/CI values take priority. Private keys must not use the VITE_ prefix.
# Packaged apps do not ship or load the repository's .env.local.
VITE_PUBLIC_APP_URL=http://localhost:5502
# App-owned Better Auth backend. Its Generic OAuth provider authenticates at SSO.
VITE_PUBLIC_AUTH_URL=http://localhost:5504
# Must match electron({ clientID }) on that website, not the website OAuth ID.
VITE_PUBLIC_OAUTH_CLIENT_ID=gorth-launcher

# Main-process-only game/provider settings.
JAVA_HOME=
CURSEFORGE_API_KEY=
